rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function directoryAdmin() {
      return signedIn()
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && exists(/databases/$(database)/documents/members/$(request.auth.token.get('email', '')))
        && get(/databases/$(database)/documents/members/$(request.auth.token.get('email', ''))).data.active == true
        && get(/databases/$(database)/documents/members/$(request.auth.token.get('email', ''))).data.get('adminAccess', false) == true;
    }
    function directoryMember() {
      return signedIn()
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').size() > 0
        && exists(/databases/$(database)/documents/members/$(request.auth.token.get('email', '')))
        && get(/databases/$(database)/documents/members/$(request.auth.token.get('email', ''))).data.active == true
        && get(/databases/$(database)/documents/members/$(request.auth.token.get('email', ''))).data.get('memberAccess', false) == true;
    }
    function admin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true || directoryAdmin());
    }
    function member() {
      return signedIn()
        && (request.auth.token.get('member', false) == true || directoryMember());
    }
    function authDisplayName() {
      return request.auth.token.get(
        'name',
        request.auth.token.get('email', '구성원')
      );
    }
    function publishedChatChannel(channelId) {
      return exists(/databases/$(database)/documents/chatChannels/$(channelId))
        && get(/databases/$(database)/documents/chatChannels/$(channelId)).data.published == true;
    }
    function canReadChat(channelId) {
      return admin() || (member() && publishedChatChannel(channelId));
    }
    function canPostChat(channelId) {
      return admin()
        || (member()
          && publishedChatChannel(channelId)
          && get(/databases/$(database)/documents/chatChannels/$(channelId)).data.kind == 'chat');
    }
    function publicOrAdmin() { return admin() || resource.data.published == true; }
    function privacyReady() {
      return exists(/databases/$(database)/documents/site/privacy)
        && get(/databases/$(database)/documents/site/privacy).data.published == true
        && get(/databases/$(database)/documents/site/privacy).data.operator is string
        && get(/databases/$(database)/documents/site/privacy).data.operator.size() > 0
        && get(/databases/$(database)/documents/site/privacy).data.contact is string
        && get(/databases/$(database)/documents/site/privacy).data.contact.size() > 0
        && get(/databases/$(database)/documents/site/privacy).data.retention is string
        && get(/databases/$(database)/documents/site/privacy).data.retention.size() > 0
        && get(/databases/$(database)/documents/site/privacy).data.body is string
        && get(/databases/$(database)/documents/site/privacy).data.body.size() > 0;
    }
    function validMemberDocument(memberEmail) {
      return request.resource.data.keys().hasOnly([
          'email', 'displayName', 'active', 'adminAccess', 'memberAccess', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'active', 'adminAccess', 'memberAccess', 'updatedAt'
        ])
        && request.resource.data.email == memberEmail
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.adminAccess is bool
        && request.resource.data.memberAccess is bool
        && request.resource.data.updatedAt == request.time;
    }

    match /site/{documentId} {
      allow read: if documentId == 'overview' || (documentId == 'privacy' && resource.data.published == true) || admin();
      allow write: if admin();
    }
    match /history/{itemId} {
      allow read: if publicOrAdmin();
      allow write: if admin();
    }
    match /notices/{itemId} {
      allow read: if publicOrAdmin();
      allow write: if admin();
    }
    match /products/{itemId} {
      allow read: if publicOrAdmin();
      allow write: if admin();
    }
    match /events/{eventId} {
      allow read: if publicOrAdmin();
      allow write: if admin();
    }
    match /intranetNotices/{itemId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetResources/{itemId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetProjects/{itemId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetMeetings/{itemId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetProfiles/{itemId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetEvents/{eventId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();
    }
    match /intranetEventRsvps/{rsvpId} {
      allow read: if admin() || member();
      allow create, update: if (admin() || member())
        && request.resource.data.keys().hasOnly([
          'eventId', 'userId', 'displayName', 'response', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'eventId', 'userId', 'displayName', 'response', 'updatedAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() <= 1500
        && rsvpId == request.resource.data.eventId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName == authDisplayName()
        && request.resource.data.response in ['going', 'maybe', 'not-going']
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/intranetEvents/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/intranetEvents/$(request.resource.data.eventId)).data.published == true;
      allow delete: if admin()
        || ((member() || admin()) && resource.data.userId == request.auth.uid);
    }
    match /chatChannels/{channelId} {
      allow read: if admin() || (member() && resource.data.published == true);
      allow write: if admin();

      match /messages/{messageId} {
        allow read: if canReadChat(channelId);
        allow create: if canPostChat(channelId)
          && request.resource.data.keys().hasOnly([
            'authorUid', 'authorName', 'text', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'authorUid', 'authorName', 'text', 'createdAt'
          ])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == authDisplayName()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if admin()
          || (canReadChat(channelId) && resource.data.authorUid == request.auth.uid);
      }
    }
    match /members/{memberEmail} {
      allow read: if admin()
        || (signedIn() && request.auth.token.get('email', '') == memberEmail);
      allow create: if admin() && validMemberDocument(memberEmail);
      allow update: if admin()
        && validMemberDocument(memberEmail)
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') != memberEmail
          || (request.resource.data.active == true
            && request.resource.data.get('adminAccess', false) == true));
      allow delete: if admin()
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') != memberEmail);
    }
    match /adminAuditLogs/{logId} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['action', 'target', 'details', 'actor', 'createdAt'])
        && request.resource.data.keys().hasAll(['action', 'target', 'details', 'actor', 'createdAt'])
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.target is string
        && request.resource.data.target.size() > 0
        && request.resource.data.target.size() <= 300
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.actor == request.auth.token.get('email', '')
        && request.resource.data.actor.size() > 0
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /applications/{applicationId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && applicationId == request.auth.uid + '_' + request.resource.data.eventId
        && request.resource.data.keys().hasOnly(['userId', 'eventId', 'name', 'email', 'phone', 'motivation', 'consent', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['userId', 'eventId', 'name', 'email', 'phone', 'motivation', 'consent', 'status', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && request.resource.data.eventId.size() < 120
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && privacyReady()
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.published == true
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.registrationOpen == true
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.registrationDeadlineAt is timestamp
        && get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data.registrationDeadlineAt > request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 30
        && request.resource.data.motivation is string && request.resource.data.motivation.size() <= 1000
        && request.resource.data.consent == true
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status in ['new', 'reviewing']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled');
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
