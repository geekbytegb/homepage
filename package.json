{
  "name": "geek-byte-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.js",
    "format:check": "prettier --check src tests scripts vite.config.ts eslint.config.js",
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:rules:emulator": "npx firebase-tools@15.30.2 emulators:exec --project demo-geek-byte --only firestore \"npm run test:rules\"",
    "grant-admin": "node scripts/grant-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^14.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.3.0"
  }
}
